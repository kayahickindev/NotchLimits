#!/opt/homebrew/bin/python3
"""nl-usage: NotchLimits data source shim.

Runs `cswap list --json` (Claude accounts) and, in parallel, reads Codex
rate limits over `codex app-server` JSON-RPC (account/rateLimits/read),
then prints one merged cswap-schema JSON document with Codex appended as
account slot 99. NotchLimits points at this script instead of cswap.

Codex mapping: the unnamed account-wide limit's 300-min window -> fiveHour,
10080-min -> sevenDay; named per-model limits (e.g. GPT-5.3-Codex-Spark)
become scoped meters labeled "<Model> 5h" / "<Model> 7d". A failed Codex
read falls back to a <30-min-old cache as lastGoodUsage (stale row);
with no usable cache the Codex row is simply omitted.

When `cswap codex` manages several Codex logins, each one gets its own row
(slot 100 + its number) from the readings `cswap codex auto` keeps, with a
Switch button that runs `cswap codex switch`; the single live-login read
above is then skipped.

If cswap itself fails or emits non-JSON, its output and exit code pass
through untouched so the app's normal error path still works.
"""
import calendar
import json
import os
import subprocess
import sys
import threading
import time

CSWAP = os.path.expanduser("~/.local/bin/cswap")
CODEX = os.path.expanduser("~/.local/bin/codex")
CACHE = os.path.expanduser("~/.cache/nl-codex-usage.json")
CODEX_SLOT = 99
CODEX_ROW_BASE = 100
CACHE_MAX_AGE_S = 30 * 60

# The app kills its child after 10s; keep worst-case under that.
CSWAP_TIMEOUT_S = 8
CODEX_TIMEOUT_S = 6


def iso_utc(epoch):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(epoch))


def window_label(minutes):
    return "5h" if (minutes or 0) <= 600 else "7d"


def meter(window, name=None):
    m = {
        "pct": float(window.get("usedPercent") or 0),
        "resetsAt": iso_utc(window["resetsAt"]) if window.get("resetsAt") else None,
        "countdown": None,
        "clock": None,
    }
    if name is not None:
        m["name"] = name
    return m


def map_codex_usage(rate_limits):
    by_id = rate_limits.get("rateLimitsByLimitId") or {"codex": rate_limits}
    five = seven = None
    scoped = []
    for limit in by_id.values():
        name = limit.get("limitName")
        short = name.split("-")[-1] if name else None
        for window in (limit.get("primary"), limit.get("secondary")):
            if not window:
                continue
            label = window_label(window.get("windowDurationMins"))
            if short:
                scoped.append(meter(window, "%s %s" % (short, label)))
            elif label == "5h" and five is None:
                five = meter(window)
            elif label == "7d" and seven is None:
                seven = meter(window)
            else:
                scoped.append(meter(window, label))
    if five is None and seven is None and not scoped:
        return None
    return {"fiveHour": five, "sevenDay": seven, "scoped": scoped}


def fetch_codex(result_box):
    request_lines = (
        '{"jsonrpc":"2.0","id":1,"method":"initialize","params":'
        '{"clientInfo":{"name":"nl-usage","title":"nl-usage","version":"1.0"}}}\n'
        '{"jsonrpc":"2.0","method":"initialized"}\n'
        '{"jsonrpc":"2.0","id":2,"method":"account/rateLimits/read","params":{}}\n'
    )
    try:
        proc = subprocess.Popen(
            [CODEX, "app-server"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except OSError:
        return
    watchdog = threading.Timer(CODEX_TIMEOUT_S, proc.kill)
    watchdog.start()
    try:
        proc.stdin.write(request_lines)
        proc.stdin.flush()
        for line in proc.stdout:
            try:
                msg = json.loads(line)
            except ValueError:
                continue
            if msg.get("id") == 2:
                result = msg.get("result") or {}
                usage = map_codex_usage(result.get("rateLimits") or {})
                if usage:
                    result_box["usage"] = usage
                return
    except (OSError, ValueError):
        pass
    finally:
        watchdog.cancel()
        proc.kill()


def read_cache():
    try:
        with open(CACHE) as f:
            cached = json.load(f)
        if time.time() - cached.get("fetchedAt", 0) <= CACHE_MAX_AGE_S:
            return cached
    except (OSError, ValueError):
        pass
    return None


def write_cache(usage):
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        with open(CACHE, "w") as f:
            json.dump({"fetchedAt": time.time(), "usage": usage}, f)
    except OSError:
        pass


def codex_account(fresh_usage):
    now = time.time()
    account = {
        "number": CODEX_SLOT,
        "email": "codex@openai.com",
        "organizationName": "OpenAI Codex",
        "alias": "codex",
        "active": False,
        "usageStatus": "ok",
        "usage": None,
        "lastGoodUsage": None,
        "usageFetchedAt": None,
        "usageAgeSeconds": None,
        "lastGoodFetchedAt": None,
        "lastGoodAgeSeconds": None,
    }
    if fresh_usage:
        write_cache(fresh_usage)
        account["usage"] = fresh_usage
        account["usageFetchedAt"] = iso_utc(now)
        account["usageAgeSeconds"] = 0.0
        return account
    cached = read_cache()
    if cached:
        account["lastGoodUsage"] = cached["usage"]
        account["lastGoodFetchedAt"] = iso_utc(cached["fetchedAt"])
        account["lastGoodAgeSeconds"] = now - cached["fetchedAt"]
        return account
    return None


def parse_iso(value):
    try:
        return calendar.timegm(time.strptime(value, "%Y-%m-%dT%H:%M:%SZ"))
    except (TypeError, ValueError):
        return None


def wire_usage(reading):
    """A `cswap codex list` reading in cswap's wire schema, or None."""
    if not isinstance(reading, dict) or reading.get("error"):
        return None
    five = seven = None
    scoped = []
    for window in reading.get("windows") or []:
        m = {"pct": float(window.get("pct") or 0), "resetsAt": window.get("resetsAt"),
             "countdown": None, "clock": None}
        label = window.get("label")
        if label == "5h" and five is None:
            five = m
        elif label == "7d" and seven is None:
            seven = m
        else:
            m["name"] = label
            scoped.append(m)
    if five is None and seven is None and not scoped:
        return None
    return {"fiveHour": five, "sevenDay": seven, "scoped": scoped}


def cswap_codex_rows():
    """One row per login `cswap codex` manages, or None to use the single
    live-login read instead."""
    try:
        out = subprocess.run(
            [CSWAP, "codex", "list", "--json", "--cached"],
            capture_output=True, text=True, timeout=CODEX_TIMEOUT_S,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    raw = out.stdout
    brace = raw.find("{")
    if out.returncode != 0 or brace < 0:
        return None
    try:
        accounts = json.loads(raw[brace:]).get("accounts") or []
    except (ValueError, AttributeError):
        return None
    now = time.time()
    rows = []
    for account in accounts:
        number = account.get("number")
        if not isinstance(number, int):
            continue
        email = account.get("email") or ""
        plan = account.get("plan") or ""
        reading = account.get("usage") or {}
        usage = wire_usage(reading)
        fetched = parse_iso(reading.get("fetchedAt"))
        fresh = usage is not None and fetched is not None and now - fetched <= CACHE_MAX_AGE_S
        active = bool(account.get("active"))
        rows.append({
            "number": CODEX_ROW_BASE + number,
            "email": email,
            "organizationName": "OpenAI Codex",
            "alias": "codex %s%s" % (email.split("@")[0] or "login", " · " + plan if plan else ""),
            "active": active,
            "switchable": not active,
            "switchArgs": ["codex", "switch", str(number), "--json"],
            "usageStatus": "ok",
            "usage": usage if fresh else None,
            "lastGoodUsage": None if fresh else usage,
            "usageFetchedAt": iso_utc(fetched) if fetched else None,
            "usageAgeSeconds": (now - fetched) if fetched else None,
            "lastGoodFetchedAt": None,
            "lastGoodAgeSeconds": None,
        })
    return rows or None


def main():
    codex_rows = cswap_codex_rows()
    codex_box = {}
    codex_thread = threading.Thread(target=fetch_codex, args=(codex_box,))
    if codex_rows is None:
        codex_thread.start()

    try:
        cswap = subprocess.run(
            [CSWAP, "list", "--json"],
            capture_output=True,
            text=True,
            timeout=CSWAP_TIMEOUT_S,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        if codex_thread.is_alive():
            codex_thread.join(CODEX_TIMEOUT_S)
        sys.stderr.write("nl-usage: cswap failed: %s\n" % e)
        sys.exit(1)

    if codex_thread.is_alive():
        codex_thread.join(CODEX_TIMEOUT_S + 1)

    # cswap may print an upgrade-notice line before the JSON payload.
    raw = cswap.stdout
    brace = raw.find("{")
    payload = None
    if brace >= 0:
        try:
            payload = json.loads(raw[brace:])
        except ValueError:
            payload = None
    if payload is None:
        sys.stdout.write(raw)
        sys.stderr.write(cswap.stderr)
        sys.exit(cswap.returncode)

    if codex_rows is not None:
        rows = codex_rows
    else:
        row = codex_account(codex_box.get("usage"))
        rows = [row] if row is not None else []
    if rows:
        taken = {r["number"] for r in rows} | {CODEX_SLOT}
        payload.setdefault("accounts", [])
        payload["accounts"] = [
            a for a in payload["accounts"] if a.get("number") not in taken
        ] + rows
    json.dump(payload, sys.stdout)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
